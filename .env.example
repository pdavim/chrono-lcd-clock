# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Internal HTTP port the Express server listens on (default: 3000).
PORT=3000

# APP_URL: Public HTTPS URL where this app is hosted (e.g. https://clock.yourdomain.com).
# Used for OAuth callbacks and secure session cookies behind reverse proxies like Dokploy/Traefik.
APP_URL="MY_APP_URL"

# Optional Spotify OAuth credentials to browse personal Spotify library playlists.
# Public Spotify playlist/album URLs work immediately without credentials via Spotify Embed.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

